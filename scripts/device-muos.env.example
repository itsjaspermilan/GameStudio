# Copy to scripts/device-muos.env; send with GS_DEVICE=muos scripts/push.sh carts/<game>.
# Enable USB ADB in the firmware and connect a data cable. No SSH service or password is used.
DEVICE_OS=muos
DEVICE_SERIAL=                 # adb devices -l; required when several devices are attached
DEVICE_DIR=/mnt/mmc/gs
DEVICE_ROMS_DIR=/mnt/mmc/ROMS
# ADB=/absolute/path/to/adb
