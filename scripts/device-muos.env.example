# Copy to scripts/device-muos.env and edit; send with GS_DEVICE=muos scripts/push.sh carts/<game> (scripts/device.env stays the default).
# muOS (MustardOS): turn on Secure Shell in its settings. SSH user root, password root unless you changed it. muOS does not announce its
# hostname on most networks, so use its IP address (its network settings show it; a DHCP reservation in the router keeps it fixed).
DEVICE_OS=muos
DEVICE_HOST=192.168.1.50
DEVICE_USER=root
DEVICE_DIR=/mnt/mmc/gs        # where gs, the SoundFont and the cartridges live (the games card)
DEVICE_ROMS_DIR=/mnt/mmc/ROMS # each console gets a folder here ("Glow43"), assigned to muOS's External - Ports system
# Open one connection by hand (type the password once) and reuse it:
#   ssh -fN -o ControlMaster=yes -o ControlPath=$HOME/.ssh/muos-ctl -o ServerAliveInterval=15 root@<ip>
SSH_OPTS="-o ControlPath=$HOME/.ssh/muos-ctl"
