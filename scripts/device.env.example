# Copy to scripts/device.env. The firmware must provide USB ADB shell and file transfer.
# Install Android SDK Platform-Tools on the computer; connect a data cable and enable ADB on the handheld.
DEVICE_OS=knulli
DEVICE_SERIAL=                 # adb devices -l; empty selects only when exactly one device is attached
DEVICE_DIR=/userdata/gs
DEVICE_PORTS_DIR=/userdata/roms/ports
DEVICE_ROMS_DIR=/userdata/roms   # empty sends every game to Ports instead of a console system
# ADB=/absolute/path/to/adb      # optional; otherwise PATH and standard SDK folders are checked
# Optional command to free the display before scripts/run.sh launches the standalone runtime:
# DEVICE_STOP_FRONTEND="batocera-es-swissknife --emukill"
