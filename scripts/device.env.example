# Copy to scripts/device.env and edit. Defaults below are for Knulli (per knulli.org: SSH user root, /userdata is the only lasting writable place).
# Turn on System settings > Services > SSH on the device first. Run `ssh-copy-id root@<ip>` once so push.sh does not ask for the password each time.
DEVICE_HOST=192.168.1.50      # IP or hostname of the handheld (KNULLI), see the device's network settings
DEVICE_USER=root
DEVICE_DIR=/userdata/gs       # where gs + cartridges live
# A folder the frontend scans for launch scripts, so each cart appears in the menu as its own entry (Knulli: the Ports system)
DEVICE_PORTS_DIR=/userdata/roms/ports
# Optional: the roms folder. With it, each cart's console (Glow43, Glow169, ...) becomes its own EmulationStation system with its own folder
# here and an entry in es_systems_gamestudio.cfg; without it every cart goes into the Ports folder above
DEVICE_ROMS_DIR=/userdata/roms
# Optional: command to free the display before running from SSH (KMSDRM needs the screen to itself)
# DEVICE_STOP_FRONTEND="killall emulationstation"
# Optional extra ssh/scp options. To avoid keeping a key on the device, open one connection by hand (type the password once) and reuse it:
#   ssh -fN -o ControlMaster=yes -o ControlPath=~/.ssh/knulli-ctl root@knulli.local
# SSH_OPTS="-o ControlPath=$HOME/.ssh/knulli-ctl"
