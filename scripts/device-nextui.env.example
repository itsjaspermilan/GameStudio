# Copy to scripts/device-<name>.env; send with GS_DEVICE=<name> scripts/push.sh carts/<game>.
# Enable USB ADB in the firmware, connect a data cable, and accept authorization if the handheld asks.
DEVICE_OS=nextui
DEVICE_SERIAL=                 # adb devices -l; required when several devices are attached
DEVICE_DIR=/mnt/SDCARD/GameStudio
DEVICE_SDCARD=/mnt/SDCARD
DEVICE_PLATFORM=tg5040          # check Emus/<platform> on this handheld; do not assume every device uses tg5040
# ADB=/absolute/path/to/adb
