# Copy to scripts/device-<name>.env (one per Brick: device-brick.env, ...) and edit; send with GS_DEVICE=<name> scripts/push.sh carts/<game>.
# NextUI (the TrimUI Brick): install "Native SSH" from the Pak Store (Tools) and start it. It needs TrimUI's firmware 1.1 or newer. SSH user
# root. Use the Brick's IP address (Settings > Network shows it; a DHCP reservation in the router keeps it fixed).
DEVICE_OS=nextui
DEVICE_HOST=192.168.1.50
DEVICE_USER=root
DEVICE_DIR=/mnt/SDCARD/GameStudio  # gs, the SoundFont and the pad map (NextUI's menu does not show this folder)
# DEVICE_PLATFORM=tg5040           # NextUI's name for the Brick and the Smart Pro
# Log in without a password: run scripts/setup-key.sh root@<ip> once (it asks the Brick's password one time). push.sh then opens this
# shared connection by itself, the same one the studio uses.
SSH_OPTS="-o ControlPath=$HOME/.ssh/gamestudio-%r@%h"
