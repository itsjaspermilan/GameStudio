{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameStudio",
  "version": "0.1.0",
  "identifier": "com.gamestudio.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && sh ../scripts/fetch-luals.sh --if-missing",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "GameStudio", "width": 1200, "height": 780, "minWidth": 800, "minHeight": 520, "dragDropEnabled": false }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "../../third_party/luals": "luals" }
  }
}
